        float alpha=1.0-exp(-gemRow(214).w*weight*min(density,1.0)/max(abs(ray.z),0.12));
        result+=transmission*alpha*gemControlEngravingLight(pose.xyz+point*pose.w,medium,pose.w);
        transmission*=1.0-alpha;
