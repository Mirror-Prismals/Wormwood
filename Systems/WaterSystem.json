          "Step"
        ],
        "sources": [
          "Water/bodies.rs",
          "Water/surface_mesh.rs",
          "BaseSystem/LayerFive/WaterSystem.rs",
          "Theatre/Waterpark.rs"
        ],
        "checks": [
          {
            "id": "waterpark_authored_basins_behavior",
            "kind": "behavior",
            "expectation": "Each basin has a measured bed and exact surface boundary. Water membership rejects points above the surface or outside the basin. Both basins and films fit native water budgets. Lazy-river reaches carry a slow circulating current, with a dry central island. Three independently gated courses share the bounded film solver.",
            "procedure": "Run cargo test --offline --locked --lib waterpark. Review Blender overview and WORMWOOD_CHECK_WATERPARK=1 native theatre exterior captures. Manual full-game traversal remains separate validation."
          }
        ]
      }
