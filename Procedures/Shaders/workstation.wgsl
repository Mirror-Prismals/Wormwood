// Generated by Procedures/Shaders/generate_workstation.py. Edit workstation.shared.glsl.
struct SceneVertex {position:vec4<f32>,data:vec4<f32>};
struct Appearance {vertices:array<SceneVertex>};
@group(0) @binding(0) var<storage,read> appearance:Appearance;
struct WorkstationData {rows:array<vec4<f32>>};
@group(0) @binding(1) var<storage,read> workstationData:WorkstationData;
fn gemRow(index:i32)->vec4<f32>{return workstationData.rows[u32(index)];}
struct VertexOutput {@builtin(position) position:vec4<f32>,@location(0) screen:vec2<f32>,@location(1) cameraData:vec4<f32>};
@vertex fn vs_main(@builtin(vertex_index) index:u32)->VertexOutput {
 var o:VertexOutput;o.position=appearance.vertices[index].position;
 o.screen=o.position.xy/o.position.w;o.cameraData=appearance.vertices[index].data;return o;
}
// Canonical workstation optical integrator. Generated frontends share these equations.
// Surface: the authored Blender Principled dielectric, white base, transmission 1,
// IOR 1.766, GGX roughness .018. Volume: authored RGB absorption per metre.
// Reshaped mesh halfspaces drive tracing; eligible primary ruby paths use baked transport.
// Deterministic Fresnel splitting retains reflection and refraction, including TIR.
// Bounded real-time quadrature is not the Cycles stochastic path integrator: the
// floor uses direct area quadrature and approximate transmission shadows (no caustics).
// Display uses a LUT evaluated from the source .blend's actual OCIO AgX transform.
struct GemHit {distance:f32,normal:vec3<f32>,panel:i32};
// Pack each vec3's fourth word: this is 48 bytes in WGSL/std430 instead of64.
// The cached scalar priority avoids loading all RGB lanes while scanning work.
struct GemRay {origin:vec3<f32>,medium:i32,direction:vec3<f32>,depth:i32,weight:vec3<f32>,priority:f32};

// USER_STYLE_FUNCTIONS
fn style_color(uv:vec2<f32>,position:vec3<f32>,size:vec2<f32>,time:f32)->vec4<f32> { return vec4<f32>(1.0); }
fn style_background(uv:vec2<f32>,time:f32)->vec3<f32> { return vec3<f32>(0.035,0.045,0.06); }
// END_USER_STYLE_FUNCTIONS

fn gemMax(a:vec3<f32>)->f32 { return max(a.x,max(a.y,a.z)); }
fn gemPick(a:f32,b:f32,choose:bool)->f32 { if(choose){return b;}return a; }
// The mobile page covers one side of the fixed timeline projection. This
// clip applies only to background furniture, never panel controls or optics.
// Row246.xy remain the UserStyle base/count; zw are zero outside a slide.
fn gemMobileBackdropAllows(point:vec2<f32>)->bool {
    var clip:vec4<f32>=gemRow(246);
    if(clip.z==12001.0){return point.y<=clip.w;}
    if(clip.z==12002.0){return point.y>=clip.w;}
    if(clip.z==12003.0){return point.x>=clip.w;}
    if(clip.z==12004.0){return point.x<=clip.w;}
    return true;
}
fn gemControlPoseRow(instance:i32)->i32 {
    if(instance>=125){return i32(gemRow(44592).x)+5*(instance-125);}
    if(instance>=65){return i32(gemRow(44288).x)+5*(instance-65);}
    if(instance>=61){return i32(gemRow(232).x)+32+2*(instance-61);}
    if(instance>=29){return i32(gemRow(247).x)+2*(instance-29);}
    if(instance>=13){return i32(gemRow(232).x)+2*(instance-13);}
    if(instance>=10){return 226+2*(instance-10);}
    return 192+2*instance;
}
fn gemTimelineInstanceRow(instance:i32)->i32 {if(instance>=192){return i32(gemRow(255).x)+12+(instance-192)*3;}return i32(gemRow(248).y)+instance*3;}
fn gemPanelRow(panel:i32)->i32 {
    if(panel>=720000&&panel<720003){return i32(gemRow(45744+8).x);}
    if(panel>=800000&&panel<853760){return 12544+40*((panel-800000)%256);}
    if(panel>=700000&&panel<704096){
        var instance:i32=(panel-700000)/16;
        return i32(gemRow(gemTimelineInstanceRow(instance)+1).z)+40*((panel-700000)%16);
    }
    if(panel>=4){
        var instance:i32=(panel-4)/256;var base:f32=gemRow(gemControlPoseRow(instance)+1).w;
        if(base<0.5){base=gemRow(12).y;}
        return i32(base)+40*((panel-4)%256);
    }
    return 32+40*panel;
}
fn gemObjectScale(panel:i32)->f32 {
    if(panel>=720000&&panel<720003){return gemRow(45744+3+panel-720000).z;}
    if(panel>=800000&&panel<853760){return gemRow(43152+8+((panel-800000)/256/3)*6+3).y;}
    if(panel>=700000&&panel<704096){
        var at:i32=gemTimelineInstanceRow((panel-700000)/16);
        if(gemRow(at+1).w< -0.5){return gemRow(at+2).z;}
        return gemRow(at).w;
    }
    if(panel>=4){return gemRow(gemControlPoseRow((panel-4)/256)).w;}
    return 1.0;
}
fn gemSafeUnit(v:vec3<f32>)->vec3<f32> { return v/max(length(v),0.0000001); }

fn gemInverseRay(ray:vec3<f32>)->vec3<f32> {
    return vec3<f32>(gemPick(1.0,-1.0,ray.x<0.0),gemPick(1.0,-1.0,ray.y<0.0),gemPick(1.0,-1.0,ray.z<0.0))/max(abs(ray),vec3<f32>(0.00000001));
}
fn gemBox(origin:vec3<f32>,inverseRay:vec3<f32>,center:vec3<f32>,extent:vec3<f32>,farLimit:f32)->bool {
    var a:vec3<f32>=(center-extent-origin)*inverseRay;var b:vec3<f32>=(center+extent-origin)*inverseRay;
    var lo:vec3<f32>=min(a,b);var hi:vec3<f32>=max(a,b);
    return min(min(hi.x,hi.y),min(hi.z,farLimit))>=max(max(lo.x,lo.y),max(lo.z,0.0));
}
// User panel meshes use their original triangles, including zero-thickness faces.
// Inverse nonuniform transforms preserve world ray t; normals use inverse transpose.
// IDs 200000..599999 encode logical panel and immutable triangle row.
fn userPanel(id:i32)->i32 { return (id-200000)/100000; }
fn userTriangle(id:i32)->i32 { return i32(gemRow(246).x)+(id-200000)%100000; }
fn userBarycentric(triangle:i32,p:vec3<f32>)->vec2<f32> {
    var a:vec3<f32>=gemRow(triangle).xyz;
    var e:vec3<f32>=gemRow(triangle+1).xyz-a;var f:vec3<f32>=gemRow(triangle+2).xyz-a;var q:vec3<f32>=p-a;
    var area:vec3<f32>=cross(e,f);var den:f32=max(dot(area,area),1e-30);
    var u:f32=dot(cross(q,f),area)/den;
    var v:f32=dot(cross(e,q),area)/den;
    return vec2<f32>(u,v);
}
// A long ray's rounded t can put a skinny triangle's hit several float32
// units beneath its surface. Rebuild from the original triangle before
// shading or launching shadow rays; increasing bias would erase real relief.
fn userSurfacePoint(triangle:i32,p:vec3<f32>)->vec3<f32> {
    var bary:vec2<f32>=userBarycentric(triangle,p);var a:vec3<f32>=gemRow(triangle).xyz;
    return a+(gemRow(triangle+1).xyz-a)*bary.x+(gemRow(triangle+2).xyz-a)*bary.y;
}
fn userUV(triangle:i32,p:vec3<f32>)->vec2<f32> {
    var bary:vec2<f32>=userBarycentric(triangle,p);var u:f32=bary.x;var v:f32=bary.y;
    var uv:vec4<f32>=gemRow(triangle+6);
    return uv.xy*(1.0-u-v)+uv.zw*u+gemRow(triangle+7).xy*v;
}
fn userColor(panel:i32,triangle:i32,local:vec3<f32>)->vec4<f32> {
    var pose:i32=32+40*panel;var material:i32=i32(gemRow(pose).w)+i32(gemRow(triangle).w)*2;
    var color:vec4<f32>=vec4<f32>(gemRow(material).xyz,1.0);
    if(gemRow(pose+2).w>0.5){
        var size:vec2<f32>=(gemRow(pose+4).xy-gemRow(pose+3).xy)*gemRow(pose+2).xy;
        color*=style_color(userUV(triangle,local),local,size,gemRow(245).w);
    }
    if(color.x!=color.x||color.y!=color.y||color.z!=color.z||color.w!=color.w){return vec4<f32>(1.0,0.0,1.0,1.0);}
    return clamp(color,vec4<f32>(0.0),vec4<f32>(65504.0,65504.0,65504.0,1.0));
}
fn userStyleHit(origin:vec3<f32>,ray:vec3<f32>,farLimit:f32,anyHit:bool,shadow:bool)->GemHit {
    var hit:GemHit=GemHit(farLimit,vec3<f32>(0.0),-1);
    if(gemRow(245).x<0.5){return hit;}
    for(var panel:i32=0;panel<4;panel++){
        var pose:i32=32+40*panel;
        if(gemRow(pose+1).w<0.5||gemRow(pose).x>0.5){continue;}
        var scale:vec3<f32>=gemRow(pose+2).xyz;
        var local:vec3<f32>=(origin-gemRow(pose+1).xyz)/scale;var direction:vec3<f32>=ray/scale;
        var inverse:vec3<f32>=gemInverseRay(direction);
        var node:i32=i32(gemRow(pose).y);var end:i32=i32(gemRow(pose).z);
        for(var visit:i32=0;visit<8192;visit++){
            if(node>=end){break;}
            var lo:vec4<f32>=gemRow(node);var hi:vec4<f32>=gemRow(node+1);
            if(!gemBox(local,inverse,(lo.xyz+hi.xyz)*0.5,(hi.xyz-lo.xyz)*0.5+vec3<f32>(0.0000001),hit.distance)){
                node=i32(lo.w);continue;
            }
            var count:i32=i32(gemRow(node+2).x);
            if(count==0){node+=3;continue;}
            for(var index:i32=0;index<4;index++){
                if(index>=count){break;}
                var at:i32=i32(hi.w)+8*index;
                var a:vec3<f32>=gemRow(at).xyz;var e:vec3<f32>=gemRow(at+1).xyz-a;var f:vec3<f32>=gemRow(at+2).xyz-a;
                var h:vec3<f32>=cross(direction,f);var det:f32=dot(e,h);
                if(abs(det)<1e-7*length(e)*length(f)*length(direction)){continue;}
                if(!shadow&&det<0.0&&gemRow(at+2).w<0.5){continue;}
                var offset:vec3<f32>=local-a;var u:f32=dot(offset,h)/det;
                if(u<0.0||u>1.0){continue;}
                var q:vec3<f32>=cross(offset,e);var v:f32=dot(direction,q)/det;
                if(v<0.0||u+v>1.0){continue;}
                var t:f32=dot(f,q)/det;
                if(t<=0.0000001||t>=hit.distance){continue;}
                if(userColor(panel,at,a+e*u+f*v).w<0.5){continue;}
                var normal:vec3<f32>=gemRow(at+3).xyz*(1.0-u-v)+gemRow(at+4).xyz*u+gemRow(at+5).xyz*v;
                normal=gemSafeUnit(normal/scale);
                if(dot(normal,ray)>0.0){normal=-normal;}
                hit=GemHit(t,normal,200000+panel*100000+at-i32(gemRow(246).x));
                if(anyHit){return hit;}
            }
            node=i32(lo.w);
        }
    }
    return hit;
}

// Authored indexed membrane geometry; no textures, noise, SDF or implicit skin.
// Included after GemHit, gemSafeUnit, gemInverseRay and gemBox are available.
// Rows234..237 match BubbleNotes.rs. Node stride4, vertex stride6, triangle stride1.
// Native smooth normals differentiate the source membrane parameterization and
// transform through the exact squash/wave Jacobian at the current duration.
// The original Blender normals remain in the packet for source inspection.

fn gemBubbleSelected(panel:i32)->bool {
    var index:i32=panel-100000;
    if(index<0||index>=i32(gemRow(234).x)){return false;}
    return gemRow(i32(gemRow(237).x)+index).w>=4.0;
}

// x/y are shape-key weights; z is placement drop plus selected-note lift.
fn gemBubbleAnimation(encodedAge:f32,height:f32)->vec3<f32> {
    var age:f32=encodedAge;var lift:f32=0.0;var stop:f32=1.35;
    if(encodedAge>=4.0){age-=4.0;lift=0.15*height;stop+=4.0;}
    if(encodedAge>=stop){return vec3<f32>(0.0,0.0,lift);}
    if(age<0.125){
        var progress:f32=max(0.0,1.0-age/0.125);
        return vec3<f32>(0.0,0.0,lift+0.5*height*progress*progress);
    }
    var tau:f32=age-0.125;
    return vec3<f32>(exp(-6.0*tau)*cos(20.0*tau),exp(-4.9*tau)*sin(25.0*tau),lift);
}

fn gemBubbleRest(vertex:i32,width:f32,height:f32)->vec3<f32> {
    var at:i32=i32(gemRow(236).z)+vertex*6;
    var c:vec4<f32>=gemRow(at);var radius:f32=min(width*0.46,height*0.28);
    return vec3<f32>(c.x*width+c.y*radius,c.z*height+c.w*radius,gemRow(at+1).x*height);
}

fn gemBubbleVertex(vertex:i32,width:f32,height:f32,animation:vec3<f32>)->vec3<f32> {
    var p:vec3<f32>=gemBubbleRest(vertex,width,height);
    var u:f32=p.x/width;var v:f32=2.0*p.y/height;
    var sine:f32=sin(3.141592653589793*u);var ends:f32=sine*sine;
    var wave:f32=sin(6.283185307179586*u);var across:f32=1.0-v*v;
    var y:f32=p.y+animation.x*0.1*p.y*across*ends+animation.y*(height/24.0)*wave*across*ends;
    var z:f32=p.z*(1.0-0.32*animation.x+0.125*animation.y*wave*ends)+animation.z;
    return vec3<f32>(p.x,y,z);
}

fn gemBubbleNormal(vertex:i32,width:f32,height:f32,animation:vec3<f32>)->vec3<f32> {
    var at:i32=i32(gemRow(236).z)+vertex*6;
    var c:vec4<f32>=gemRow(at);var ring:vec4<f32>=gemRow(at+1);var tangent:vec2<f32>=gemRow(at+2).xy;
    var p:vec3<f32>=gemBubbleRest(vertex,width,height);var n:vec3<f32>=vec3<f32>(0.0,0.0,ring.w);
    if(abs(ring.w)<0.5){
        // Divide by height before normalization to keep very small UI notes
        // numerically well conditioned. The boundary tangent's scale cancels.
        var boundary:vec2<f32>=vec2<f32>(p.x-width*0.5,p.y)/(ring.y*height);
        n=vec3<f32>(0.3*ring.y*tangent.y,-0.3*ring.y*tangent.x,
               ring.z*(boundary.x*tangent.y-boundary.y*tangent.x));
    }
    var u:f32=p.x/width;var v:f32=2.0*p.y/height;
    var sine:f32=sin(3.141592653589793*u);var ends:f32=sine*sine;
    var wave:f32=sin(6.283185307179586*u);
    var endsX:f32=(3.141592653589793/width)*wave;
    var waveX:f32=(6.283185307179586/width)*cos(6.283185307179586*u);
    var combinedX:f32=waveX*ends+wave*endsX;
    var across:f32=1.0-v*v;
    var yX:f32=animation.x*0.1*p.y*across*endsX+animation.y*(height/24.0)*across*combinedX;
    var yY:f32=1.0+animation.x*0.1*(1.0-3.0*v*v)*ends
              -animation.y*(height/24.0)*wave*ends*(8.0*p.y/(height*height));
    var zX:f32=p.z*0.125*animation.y*combinedX;
    var zZ:f32=1.0-0.32*animation.x+0.125*animation.y*wave*ends;
    // Inverse-transpose of [[1,0,0],[yX,yY,0],[zX,0,zZ]]. Both diagonal
    // factors remain positive throughout the authored damped placement curves.
    return gemSafeUnit(vec3<f32>(n.x-yX*n.y/yY-zX*n.z/zZ,n.y/yY,n.z/zZ));
}

fn gemBubbleNodeBox(node:i32,origin:vec3<f32>,inverseRay:vec3<f32>,width:f32,height:f32,animation:vec3<f32>,farLimit:f32)->bool {
    var low:vec4<f32>=gemRow(node);var high:vec4<f32>=gemRow(node+1);var links:vec4<f32>=gemRow(node+2);
    var radius:f32=min(width*0.46,height*0.28);
    var lo:vec3<f32>=vec3<f32>(low.x*width+low.y*radius,low.z*height+low.w*radius,links.x*height);
    var hi:vec3<f32>=vec3<f32>(high.x*width+high.y*radius,high.z*height+high.w*radius,links.y*height);
    // Independent positive-parameter coefficient extrema bound every duration.
    // Exact local y stays within [-height/2,height/2] before placement; clamp
    // only its bounding interval before applying the complete displacement bound.
    lo.y=max(lo.y,-height*0.5);hi.y=min(hi.y,height*0.5);
    var yChange:f32=0.1*abs(animation.x)*max(abs(lo.y),abs(hi.y))+abs(animation.y)*height/24.0;
    lo.y-=yChange;hi.y+=yChange;
    var factor:f32=1.0-0.32*animation.x;
    lo.z=lo.z*(factor-0.125*abs(animation.y))+animation.z;
    hi.z=hi.z*(factor+0.125*abs(animation.y))+animation.z;
    var guard:f32=max(0.00000001,height*0.00001);
    return gemBox(origin,inverseRay,(lo+hi)*0.5,(hi-lo)*0.5+vec3<f32>(guard),farLimit);
}

fn gemBubbleTriangle(triangle:i32,instance:i32,local:vec3<f32>,ray:vec3<f32>,width:f32,height:f32,animation:vec3<f32>,translation:vec2<f32>,farLimit:f32,previous:GemHit)->GemHit {
    var ids:vec3<f32>=gemRow(triangle).xyz;
    var a:vec3<f32>=gemBubbleVertex(i32(ids.x),width,height,animation);
    var e1:vec3<f32>=gemBubbleVertex(i32(ids.y),width,height,animation)-a;
    var e2:vec3<f32>=gemBubbleVertex(i32(ids.z),width,height,animation)-a;
    var h:vec3<f32>=cross(ray,e2);var determinant:f32=dot(e1,h);
    var geometricNormal:vec3<f32>=cross(e1,e2);
    // Use actual area, not |e1|*|e2|: valid very short notes have skinny
    // triangles. A squared norm can also underflow for subpixel geometry.
    var areaComponents:vec3<f32>=abs(geometricNormal);
    var parallel:f32=0.0000001*max(areaComponents.x,max(areaComponents.y,areaComponents.z));
    // Both sides are required: each enclosing membrane is air/film/air. The
    // optical integrator decides the orientation for its current incident ray.
    if(abs(determinant)<=parallel){return previous;}
    var offset:vec3<f32>=local-a;var u:f32=dot(offset,h)/determinant;
    if(u<0.0||u>1.0){return previous;}
    var q:vec3<f32>=cross(offset,e1);var v:f32=dot(ray,q)/determinant;
    if(v<0.0||u+v>1.0){return previous;}
    var distance:f32=dot(e2,q)/determinant;
    var minimumDistance:f32=max(0.000000000000001,min(width,height)*0.000001);
    if(distance<=minimumDistance||distance>=farLimit||distance>=previous.distance){return previous;}
    var point:vec2<f32>=local.xy+ray.xy*distance+translation;var clip:vec4<f32>=gemRow(235);
    if(point.x<clip.x||point.y<clip.y||point.x>clip.z||point.y>clip.w){return previous;}
    if(!gemMobileBackdropAllows(point)){return previous;}
    var n:vec3<f32>=gemBubbleNormal(i32(ids.x),width,height,animation)*(1.0-u-v)
           +gemBubbleNormal(i32(ids.y),width,height,animation)*u
           +gemBubbleNormal(i32(ids.z),width,height,animation)*v;
    n=gemSafeUnit(n);
    if(dot(n,geometricNormal)<0.0){n=-n;}
    return GemHit(distance,n,100000+instance);
}

fn gemBubbleHit(origin:vec3<f32>,ray:vec3<f32>,farLimit:f32)->GemHit {
    var hit:GemHit=GemHit(farLimit,vec3<f32>(0.0),-1);
    var scene:vec4<f32>=gemRow(234);if(scene.x<0.5){return hit;}
    var clip:vec4<f32>=gemRow(235);var inverseRay:vec3<f32>=gemInverseRay(ray);
    var height:f32=scene.y;
    var fieldLow:vec3<f32>=vec3<f32>(clip.xy,scene.w);
    var fieldHigh:vec3<f32>=vec3<f32>(clip.zw,scene.w+1.55*height);
    if(!gemBox(origin,inverseRay,(fieldLow+fieldHigh)*0.5,(fieldHigh-fieldLow)*0.5,farLimit)){return hit;}
    var addresses:vec4<f32>=gemRow(237);var geometry:vec4<f32>=gemRow(236);
    for(var pitch:i32=0;pitch<128;pitch++){
        var group:i32=i32(addresses.y)+pitch*2;var low:vec4<f32>=gemRow(group);var high:vec4<f32>=gemRow(group+1);
        if(high.w<0.5){continue;}
        if(addresses.w>1.5){height=(high.y-low.y)/1.2;}
        if(!gemBox(origin,inverseRay,(low.xyz+high.xyz)*0.5,(high.xyz-low.xyz)*0.5+vec3<f32>(0.0000001),hit.distance)){continue;}
        for(var candidate:i32=0;candidate<2048;candidate++){
            if(candidate>=i32(high.w)){break;}
            var instance:i32=i32(low.w)+candidate;var note:vec4<f32>=gemRow(i32(addresses.x)+instance);
            var local:vec3<f32>=origin-vec3<f32>(note.xy,scene.w);var animation:vec3<f32>=gemBubbleAnimation(note.w,height);
            var lift:f32=0.0;if(note.w>=4.0){lift=0.15*height;}
            var center:vec3<f32>=vec3<f32>(note.z*0.5,0.0,lift+height*0.7);
            var extent:vec3<f32>=vec3<f32>(note.z*0.5,height*0.6,height*0.7);
            if(!gemBox(local,inverseRay,center,extent+vec3<f32>(0.0000001),hit.distance)){continue;}
            var node:i32=i32(geometry.x);
            for(var visit:i32=0;visit<2048;visit++){
                if(node>=i32(geometry.y)){break;}
                var links:vec4<f32>=gemRow(node+2);
                if(!gemBubbleNodeBox(node,local,inverseRay,note.z,height,animation,hit.distance)){
                    node=i32(links.z);continue;
                }
                var count:i32=i32(gemRow(node+3).x);
                if(count==0){node+=4;continue;}
                for(var triangle:i32=0;triangle<4;triangle++){
                    if(triangle>=count){break;}
                    hit=gemBubbleTriangle(i32(links.w)+triangle,instance,local,ray,note.z,height,animation,note.xy,farLimit,hit);
                }
                node=i32(links.z);
            }
        }
    }
    return hit;
}

// Analytic opaque ellipsoids for live source appearances. Scene RGB is linear.
// Header240..243 and four-row instances match AudioSpheres.rs. These primitives
// never enter gemAny/gemShadow, so the existing plain background stays unchanged.
// The three-light rig belongs only to these surfaces, not the panel studio.

fn gemAudioSphereHit(origin:vec3<f32>,ray:vec3<f32>,farLimit:f32)->GemHit {
    var descriptor:vec4<f32>=gemRow(240);
    var hit:GemHit=GemHit(farLimit,vec3<f32>(0.0),-1);
    if(descriptor.x<0.5){return hit;}
    if(!gemBox(origin,gemInverseRay(ray),gemRow(242).xyz,gemRow(243).xyz,farLimit)){return hit;}
    var clip:vec4<f32>=gemRow(241);
    for(var index:i32=0;index<64;index++){
        if(f32(index)>=descriptor.x){break;}
        var at:i32=i32(descriptor.y)+index*i32(descriptor.z);
        var center:vec3<f32>=gemRow(at).xyz;var radii:vec3<f32>=gemRow(at+1).xyz;
        if(!gemBox(origin,gemInverseRay(ray),center,radii,hit.distance)){continue;}
