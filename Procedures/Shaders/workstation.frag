                if(character>=size){break;}
                int cp=int(gemRow(212).y)+2*(first+character);vec4 pose=gemRow(cp);
                vec2 em=(point.xy-pose.xy)/pose.w;
                vec2 unshifted=em-shift*gemRow(213).x;
