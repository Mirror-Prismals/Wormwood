        float slope=extent*0.86/(0.85-0.07);float z=0.0;float distance=extent;
        if(ring==1){z=0.31/0.30;}
        if(ring==2){z=-slope;distance=extent+slope*0.07;}
        p=vec4(x,y,z,distance);
