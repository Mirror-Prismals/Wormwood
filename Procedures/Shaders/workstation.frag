void main(){float tf=max(length(dFdx(cameraData.xy)),length(dFdy(cameraData.xy)));if((cameraData.w>=112. && cameraData.w<=116. && cameraData.w!=114.)){pixel=exteriorSurface(cameraData,max(length(dFdx(cameraData.xyz)),length(dFdy(cameraData.xyz))));return;}if(cameraData.w>=117. && cameraData.w<=120.){pixel=carpetSurface(cameraData,max(length(dFdx(cameraData.xyz)),length(dFdy(cameraData.xyz))));return;}if(cameraData.w>=106.0 && cameraData.w<=111.0){pixel=tableSurface(cameraData,tf);return;}if(cameraData.w>=99.5 && (cameraData.w<=104.5 || cameraData.w==114.)){pixel=theatreSample(cameraData);return;}if(cameraData.w>89.5){pixel=vec4(cameraData.xyz,1.0);return;}if(gemRow(9).z>0.5&&gemBackdropVisible(screen)){discard;}pixel=workstationShade(screen);}
