fn gemTimelineMarkerBox(origin:vec3<f32>,ray:vec3<f32>,center:vec3<f32>,extent:vec3<f32>,farLimit:f32)->GemHit {
    var hit:GemHit=GemHit(farLimit,vec3<f32>(0.0),-1);
